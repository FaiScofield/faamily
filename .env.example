# ---------------------------------------------------------------------------
# 复制为 .env 后按需填写。.env 已被 .gitignore 排除，切勿提交真实值。
# 所有密钥请从对应平台获取后仅写入本地 .env。
# ---------------------------------------------------------------------------

# --- 基础 ---
APP_ENV=local

# SQLite（本地零依赖，推荐开发用）
DATABASE_URL=sqlite:///./data.db
# PostgreSQL（集成/生产用；需先 pip install "psycopg[binary]==3.2.13"）
# DATABASE_URL=postgresql+psycopg://family_butler:family_butler@localhost:5432/family_butler

# --- CORS ---
# 逗号分隔的允许来源。同源部署（网页端与 API 同一域名）时留空即可，无需 CORS。
# 仅在前后端分离部署（如前端在 Vercel、后端在 NAS）时才需要填写。
# CORS_ORIGINS=https://your-web.example.com

# --- 反向代理 ---
# 信任的代理层数。0=不信任 X-Forwarded-For（直连场景）；
# Nginx 单层反代填 1。填写过大会让攻击者伪造该头绕过限流。
# TRUSTED_PROXY_HOPS=1

# --- JWT ---
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- 后台管理 ---
# 逗号分隔的 user UUID，拥有 /admin/* 访问权；留空表示无人可访问
ADMIN_USER_IDS=
# 后台"在线用户"的判定阈值（分钟）
ONLINE_TIMEOUT_MINUTES=15

# --- 微信小程序 ---
# 获取路径：小程序后台 → 开发管理 → 开发设置 → 开发者ID / AppSecret
# AppSecret 属敏感凭据，只写入本地 .env，禁止提交到版本库
WECHAT_APP_ID=wx20b921f556e521a3
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_API_BASE=https://api.weixin.qq.com

# --- 邮件 SMTP（邮箱验证码发送）---
# 未配置时 /auth/email/send-otp 返回 503
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
