#!/usr/bin/env python
"""Git pre-commit hook: block accidental secret commits.

Native-Windows friendly (no POSIX shell dependency). Runs three checks on
staged content:

  1. detect-secrets  — entropy/keyword based secret detection, compared
                       against the reviewed .secrets.baseline
  2. path guard      — refuse to stage real .env files
  3. private keys    — refuse PEM private key blocks

Exit code 1 aborts the commit with an explanatory message.

Install:  git config core.hooksPath .githooks
"""

from __future__ import annotations

import json
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
if not (REPO_ROOT / "app").is_dir():
    # Fallback: locate the repo root by walking up from this file
    for candidate in Path(__file__).resolve().parents:
        if (candidate / "app").is_dir() and (candidate / ".git").exists():
            REPO_ROOT = candidate
            break
BASELINE = REPO_ROOT / ".secrets.baseline"

# Files that must never be committed, regardless of content
FORBIDDEN_PATTERNS = (
    re.compile(r"^\.env$"),
    re.compile(r"^\.env\.(?!example$)"),  # .env.local / .env.production ...
    re.compile(r".*\.env$"),  # prod.env
    re.compile(r".*\.pem$"),
    re.compile(r".*\.key$"),
    re.compile(r"^id_rsa.*$"),
)

PEM_MARKER = re.compile(r"-----BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----")


def run(cmd: list[str]) -> tuple[int, str]:
    """Run a command, returning (exit_code, combined_output)."""
    try:
        proc = subprocess.run(
            cmd,
            cwd=REPO_ROOT,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
        )
    except FileNotFoundError:
        return 127, f"command not found: {cmd[0]}"
    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")


def staged_files() -> list[str]:
    """Return paths staged for commit."""
    code, out = run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"])
    if code != 0:
        return []
    return [line.strip() for line in out.splitlines() if line.strip()]


def check_forbidden_paths(files: list[str]) -> list[str]:
    """Return the subset of files that must not be committed."""
    bad = []
    for f in files:
        normalized = f.replace("\\", "/")
        if any(p.match(normalized) for p in FORBIDDEN_PATTERNS):
            bad.append(f)
    return bad


def check_private_keys(files: list[str]) -> list[str]:
    """Return staged text files containing a PEM private key block."""
    hits = []
    for f in files:
        p = REPO_ROOT / f
        if not p.is_file():
            continue
        try:
            content = p.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        if PEM_MARKER.search(content):
            hits.append(f)
    return hits


def check_detect_secrets(files: list[str]) -> tuple[bool, str]:
    """Run detect-secrets-hook against the staged files.

    `detect-secrets-hook` takes the file list directly and compares findings
    against the reviewed `.secrets.baseline`. Exit code 0 = clean, 1 = new
    secrets found.

    IMPORTANT: the baseline file itself must never be scanned — it stores
    hashed fingerprints (40-char hex) that the entropy plugins would flag as
    fresh secrets, causing an ever-growing false-positive loop.
    Returns (ok, message).
    """
    hook_exe = REPO_ROOT / ".venv" / "Scripts" / "detect-secrets-hook.exe"
    if not hook_exe.exists():
        hook_exe = REPO_ROOT / ".venv" / "bin" / "detect-secrets-hook"
    if not hook_exe.exists():
        # Fall back to PATH
        hook_exe = None

    # Drop the baseline file itself from the scan set
    scan_files = [f for f in files if f.replace("\\", "/") != ".secrets.baseline"]
    if not scan_files:
        return True, "detect-secrets 检查通过（无待扫描文件）"

    cmd = (
        [str(hook_exe), "--baseline", str(BASELINE)]
        if hook_exe
        else ["detect-secrets-hook", "--baseline", str(BASELINE)]
    ) + scan_files

    code, out = run(cmd)
    if code == 127:
        return True, "detect-secrets 未安装，已跳过（不阻断提交）"
    if code == 0:
        return True, "detect-secrets 检查通过"
    return False, out


def main() -> int:
    files = staged_files()
    if not files:
        return 0

    problems: list[str] = []

    forbidden = check_forbidden_paths(files)
    if forbidden:
        problems.append(
            "以下文件包含真实密钥/证书，禁止提交:\n"
            + "\n".join(f"  - {f}" for f in forbidden)
            + "\n  真实配置请放在本地 .env（已被 .gitignore 排除），"
            "模板请写在 .env.example。"
        )

    pem = check_private_keys(files)
    if pem:
        problems.append(
            "以下文件包含私钥内容，禁止提交:\n" + "\n".join(f"  - {f}" for f in pem)
        )

    ok, message = check_detect_secrets(files)
    if not ok:
        problems.append(
            "detect-secrets 检测到疑似密钥（新增，非基线内）:\n"
            + message
            + "\n  若确属误报，执行: detect-secrets --baseline .secrets.baseline"
            "\n  若为真实密钥，请先轮换该凭据，再更新基线。"
        )

    if problems:
        print("\n" + "=" * 70, file=sys.stderr)
        print("[pre-commit] 提交被拦截：检测到潜在密钥泄露", file=sys.stderr)
        print("=" * 70, file=sys.stderr)
        for p in problems:
            print(p + "\n", file=sys.stderr)
        print("=" * 70, file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
