.page-family-create {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 0 120rpx;
}
.card { background: var(--card-bg); border-radius: var(--radius); margin: 12rpx 16rpx; padding: 24rpx 28rpx; box-shadow: var(--shadow); }
.form-item { padding: 20rpx 0; }
.form-label { display: block; font-size: 26rpx; color: var(--text); font-weight: 500; margin-bottom: 12rpx; }
.form-label.required::before { content: '* '; color: var(--danger); }
.form-input { width: 100%; padding: 16rpx 0; font-size: 28rpx; color: var(--text); }
.form-actions { margin: 40rpx 16rpx; }
.btn-primary { background: var(--primary); color: #fff; border: none; border-radius: var(--radius); padding: 24rpx 0; font-size: 30rpx; font-weight: 500; text-align: center; width: 100%; }
.btn-disabled { opacity: 0.6; }
