# ---------------------------------------------------------------------------
# Faamily — NAS deployment environment
#
# Copy to deploy/.env and fill in. This file is inside deploy/ which is
# NOT tracked by git (see .gitignore). Never commit real values.
#
#   cp deploy/.env.example deploy/.env
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# PostgreSQL password. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# JWT signing secret. Different value from the database password.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# --- Database ---------------------------------------------------------------
POSTGRES_USER=family_butler
POSTGRES_DB=family_butler

# --- Application ------------------------------------------------------------
APP_ENV=production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Comma-separated user UUIDs allowed to reach /v1/admin/*. Empty = nobody.
ADMIN_USER_IDS=

ONLINE_TIMEOUT_MINUTES=15

# --- Network ----------------------------------------------------------------
# Host port that nginx listens on.
#   8080      -> http://<nas-lan-ip>:8080/  (LAN only, no tunnel needed)
#   127.0.0.1 -> only reachable from the NAS itself
HTTP_PORT=8080

# Address to bind on. 0.0.0.0 exposes it to the LAN.
HTTP_BIND=0.0.0.0

# NOTE: WeChat's built-in browser blocks requests to private LAN addresses
# (192.168.x.x). Family members must open the link in the system browser
# (Safari / Chrome), not inside WeChat.

# --- CORS -------------------------------------------------------------------
# Leave empty for same-origin deployment (the normal case).
# Only needed if the web UI is hosted somewhere else.
CORS_ORIGINS=

# --- Optional integrations --------------------------------------------------
WECHAT_APP_ID=
WECHAT_APP_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
